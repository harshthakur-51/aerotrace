# AeroTrace firmware for ESP32-P4 chip revision 3.0 or later.
# For revisions below 3.0, add sdkconfig.defaults.rev1 (see the README).
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# The console UART carries the text link, so keep log output off it.
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
